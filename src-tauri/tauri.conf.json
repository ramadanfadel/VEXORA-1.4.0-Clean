{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VEXORA",
  "version": "2.2.0",
  "identifier": "com.vexora.cleaner",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VEXORA",
        "width": 1200,
        "height": 800,
        "minWidth": 980,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#070c16",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "أ. رمضان فاضل مصطفى (أبو مريم)",
    "copyright": "© 2026 أ. رمضان فاضل مصطفى (أبو مريم)",
    "shortDescription": "VEXORA — Clean Smarter. Run Faster.",
    "longDescription": "VEXORA is an all-in-one PC cleaner and optimizer: junk cleaning, privacy protection, registry cleanup, startup manager, uninstaller, duplicate/large file tools, disk analyzer, free-space wipe, memory boost and reversible system tuning. Designed and developed by Ramadan Fadel Mostafa (Abu Maryam).",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Arabic", "English"],
        "displayLanguageSelector": true,
        "headerImage": "../assets/installer-header.bmp",
        "sidebarImage": "../assets/installer-sidebar.bmp"
      },
      "digestAlgorithm": "sha256"
    }
  }
}
